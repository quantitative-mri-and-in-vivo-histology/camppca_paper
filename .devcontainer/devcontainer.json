// CPU config. gpu/devcontainer.json is the same plus host GPUs. Keep the two in sync.
{
  "name": "camppca_paper",
  "dockerComposeFile": [
    "docker-compose.yml"
  ],
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "eamodio.gitlens"
      ]
    }
  },
  "remoteUser": "node",
  "postCreateCommand": "/usr/local/bin/post-create.sh",
  "postStartCommand": "npm update -g @anthropic-ai/claude-code",
  "waitFor": "postStartCommand"
}
