# Machine-specific paths. Copy to `.env` (gitignored) and edit.
#   cp .env.example .env
# Both must be ABSOLUTE host paths.

# Data root. Mounted read-write at /workspace/data.
DATA_PATH=/media/you/Data/work/camppca_paper

# Host FSL install (needs bin/ and lib/). Mounted read-only at the same path.
FSLDIR=/home/you/opt/fsl

# Host ANTs install (needs bin/). Mounted read-only at the same path.
ANTSDIR=/home/you/opt/ants/ants-2.6.2

# TZ=Europe/Berlin
